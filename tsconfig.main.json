{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "../../native": ["native/index"]
    }
  },
  "include": ["src/main/**/*", "native/index.ts"],
  "exclude": ["node_modules", "native/node_modules", "native/build"]
}

